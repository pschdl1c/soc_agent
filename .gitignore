# Виртуальное окружение
.venv/

# Python
__pycache__/
*.pyc
*.pyo

# База данных (растёт с каждым ingest, не коммитим)
*.db
*.db-shm
*.db-wal

# База знаний MITRE ATT&CK - собирается локально scripts/build_kb.py или в docker build,
# не исходник (см. app/kb.py). Сам *.db уже покрыт выше, но каталог держим вне репо целиком.
/kb/

# Секреты/локальный конфиг
.env

# Загруженные через UI/API файлы логов
uploads/

# Пользовательские Sigma-правила/рулсеты (runtime-данные конкретного инстанса,
# не часть исходников приложения — см. CLAUDE.md §5)
custom_rulesets/

# Внешние клоны со своим .git (не часть этого репозитория, см. CLAUDE.md §1/§6):
# ставятся отдельно по инструкции из README (Установка / Быстрый старт).
/Zircolite/

# artifacts/ вне репо, кроме artifacts/content/ - кастом правила проекта.
/artifacts/*
!/artifacts/content/

# Bind-mount данных Docker-контейнера (uploads/custom_rulesets - см. docker-compose.yml;
# siem.db там же живёт как именованный Docker volume, не под этим путём - см. README §Docker)
/data/

# IDE
.idea/
.vscode/

# pytest
.pytest_cache/
