# Скопируй в .env и поправь под себя. Все переменные опциональны - без .env приложение
# использует значения по умолчанию из app/config.py (пути относительно корня проекта,
# host=127.0.0.1, port=8000).

# --- пути ---
# SIEM_DB_PATH=D:/__projects/soc_agent/siem.db
# SIEM_ZIRCOLITE_CONFIG_PATH=D:/__projects/soc_agent/Zircolite/config/config.yaml
# SIEM_DEFAULT_RULESET_PATH=D:/__projects/soc_agent/Zircolite/rules/rules_windows_merged.json
# SIEM_UPLOADS_DIR=D:/__projects/soc_agent/uploads
# База знаний MITRE ATT&CK (read-only SQLite, см. app/kb.py). Собери файл заранее:
#   python scripts/build_kb.py --out kb/kb.db --attack-version 15.1
# Если файла нет - вкладка «База знаний» покажет заглушку, алерты матчатся по сырым тегам.
# SIEM_KB_DB_PATH=D:/__projects/soc_agent/kb/kb.db

# --- сервер (используется при `python -m app.main`; для uvicorn CLI задаётся флагом --port) ---
# SIEM_HOST=0.0.0.0
# SIEM_PORT=8000

# --- потоковый ingest (app/ingest_queue.py) ---
# SIEM_INGEST_BATCH_SIZE=500
# SIEM_INGEST_FLUSH_INTERVAL=5.0

# --- AI-агент расследования (Этап 5, app/agent/; LangGraph + OpenAI-совместимый API) ---
# Пока не реализовано; переменные зарезервированы. Провайдер/модель выбираются здесь -
# любой OpenAI-совместимый endpoint (langchain-openai ChatOpenAI с base_url).
# SOC_AGENT_API_BASE=https://api.openai.com/v1
# SOC_AGENT_API_KEY=
# SOC_AGENT_MODEL=gpt-4o-mini
# SOC_AGENT_TEMPERATURE=0
