# Скопируй в .env и поправь под себя. Все переменные опциональны - без .env приложение
# использует значения по умолчанию из app/config.py (пути относительно корня проекта,
# host=127.0.0.1, port=8000).

# --- пути ---
# SIEM_DB_PATH=D:/__projects/soc_agent/siem.db
# SIEM_ZIRCOLITE_CONFIG_PATH=D:/__projects/soc_agent/Zircolite/config/config.yaml
# SIEM_DEFAULT_RULESET_PATH=D:/__projects/soc_agent/Zircolite/rules/rules_windows_merged.json
# SIEM_UPLOADS_DIR=D:/__projects/soc_agent/uploads

# --- сервер (используется при `python -m app.main`; для uvicorn CLI задаётся флагом --port) ---
# SIEM_HOST=0.0.0.0
# SIEM_PORT=8000

# --- потоковый ingest (app/ingest_queue.py) ---
# SIEM_INGEST_BATCH_SIZE=500
# SIEM_INGEST_FLUSH_INTERVAL=5.0
